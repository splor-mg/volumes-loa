# Token do GitHub para instalação de pacotes R privados
# Obtenha em: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Modo verbose para debug durante geração dos volumes (opcional)
# Valores: "--verbose" ou vazio
VERBOSE=

# Caminho para diretório SCPPO (opcional)
# Usado pela função copy_scppo() em utils/config/R/helper_copy.R
PATH_SCPPO=/path/to/scppo/directory