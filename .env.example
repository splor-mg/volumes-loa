# Token do GitHub para instalação de pacotes R privados
# Obtenha em: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Modo verbose para debug durante geração dos volumes (opcional)
# Valores: "--verbose" ou vazio
VERBOSE=--verbose

# Caminho para diretório SCPPO (opcional)
# Usado pela função copy_scppo() em utils/config/R/helper_copy.R
PATH_SCPPO=/path/to/scppo/directory


# Credenciais do Bitbucket para instalação de pacotes R privados - atualmente não estão sendo usadas
# BITBUCKET_AUTH_USER: seu usuário do Bitbucket
# BITBUCKET_APP_PASSWORD: token de acesso (não mais senha)
# Configure o token em: https://id.atlassian.com/manage-profile/security/api-tokens
#BITBUCKET_AUTH_USER=dcgf-admin
#BITBUCKET_APP_PASSWORD=your_bitbucket_token_here
