   for(j in 2:nrow(banco)){ #:nrow(banco)
     linha = ""
     if(toupper(banco$V5[j])!="TOTAL"){
       
       #   Para o caso que a linha não seja referente ao TOTAL
       
       if(is.na(banco$V3[j])==FALSE){ # Para o caso que o valor em FONTE deve mesclar linhas
         linha = paste(linha,"\\multirow{", banco$V3[j] ,"}{*}{\\parbox{7cm}{\\raggedright ", banco$V5[j], "}} & ", sep="")
         
      } else{ # Para o caso que não é necessário mesclar linhas. Ou seja, o conteudo é "" (Vázio)
        linha = paste(linha, banco$V5[j], " & ", sep="")
      }
       
      if (is.na(banco$V4[j])==FALSE & toupper(banco$V6[j])!="TOTAL"){ # Para o caso de IPU em que é necessário mesclar as linhas
        linha = paste(linha,"\\multicolumn{1}{c|}{\\multirow{",banco$V4[j],"}{*}{", banco$V6[j], "}} & ", 
                      "\\multicolumn{1}{c|}{", banco$V7[j], "} & ", sep="")
      } else if(toupper(banco$V6[j])=="TOTAL"){
        linha = paste(linha,"\\multicolumn{2}{c|}{", banco$V6[j], "} & ", sep="")
      } else{
        linha = paste(linha,"\\multicolumn{1}{c|}{", banco$V6[j], "} & ", "\\multicolumn{1}{c|}{", 
                      banco$V7[j], "} & ", sep="")
     }
    } else{
      linha = paste(linha,"\\multicolumn{3}{l|}{", banco$V5[j], "} & ", sep="")
     }
     for(col in 4:nColunas){
       if(col<nColunas){ # Para as demais colunas que variam na tabela
      linha = paste(linha,"\\multicolumn{1}{R{",larguras_demais_colunas, "cm}@{\\hspace{1em}}|}{ ", 
                    banco[j,(col+4)], "} & ", sep="")
       } else{
      linha = paste(linha, "\\multicolumn{1}{C{2cm}}{ ", banco[j,(col+4)], "} \\\\\n", sep="") 
       }
     }
   
  if(is.na(banco$V4[j])==FALSE & toupper(banco$V6[j])!="TOTAL"){
    linha_horizontal = paste("\\cline{3-", nColunas, "}\n", sep="")
  } else if (toupper(banco$V6[j])=="TOTAL" & toupper(banco$V5[j+1])!="TOTAL"){
    linha_horizontal = paste("\\hline\n", sep="")
    } else if ((toupper(banco$V6[j])=="TOTAL" & toupper(banco$V5[j+1])=="TOTAL") || toupper(banco$V5[j])=="TOTAL" ){
    linha_horizontal = paste("\\hline \\hline \\hline\n", sep="")
    } else{
    linha_horizontal = paste("\\cline{2-", nColunas, "}\n", sep="")
  }
    cat(linha)
    cat(linha_horizontal)
  
   }
  cat("\\end{longtable}\n")
  
