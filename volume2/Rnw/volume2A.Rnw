TratamentoNA = function(x){
  return(ifelse(is.na(x)==TRUE, "", x))
} 

dir_bancos = "C:/Users/m1312932/SEPLAG/LOA/Volume 2A/Bancos/"

registro_log = function(uo, tab, ok){
  if(ok==1){  write.table(data.frame(hora_dia=date(), uo_codigo=uo, tabela=tab, obs="OK"), 
                          file=paste(dir_bancos, "log.txt", sep=""), append = T, quote= F, 
                          sep='\t', na="", row.names = F, col.names =F)
    
    } else{  write.table(data.frame(hora_dia=date(), uo_codigo=uo, tabela=tab, obs="Tabela nao existe"), 
                         file=paste(dir_bancos, "log.txt", sep=""), append = T, quote= F, 
                         sep='\t', na="", row.names = F, col.names =F)
  }
}

